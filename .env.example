# SpinalCure Configuration Template
# Copy this to .env and fill in your values

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=spinalcure_db
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=SpinalCure <noreply@spinalcure.com>

# Security
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Site URL
SITE_URL=https://yourdomain.com

# Timezone
TIME_ZONE=Asia/Kolkata

# Logging
LOG_LEVEL=INFO

# Cache Configuration (Redis)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/1

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=3

# Patient-data encryption keys (comma separated, newest first). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Notifications: hours before an appointment to email the reminder.
# Schedule the job every 15 minutes:  */15 * * * * python manage.py send_notifications
APPOINTMENT_REMINDER_HOURS=24
